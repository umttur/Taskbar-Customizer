#include "resource.h"
#include <winver.h>

IDI_TASKBAR_CUSTOMIZER ICON "../assets/logo.ico"

1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "Taskbar Customizer\0"
            VALUE "FileVersion", "1.0.0\0"
            VALUE "InternalName", "TaskbarCustomizer\0"
            VALUE "OriginalFilename", "TaskbarCustomizer.exe\0"
            VALUE "ProductName", "Taskbar Customizer\0"
            VALUE "ProductVersion", "1.0.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
